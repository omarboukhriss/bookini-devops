pipeline {
    agent any

    environment {
        VERSION = "${TAG_NAME}"
        IMAGE_NAME = "bookini:${TAG_NAME}"
        CONTAINER_NAME = "bookini-release"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                bat """
                    echo Release build
                    echo Version: ${TAG_NAME}
                    docker --version
                    git --version
                """
            }
        }

        stage('Build') {
            parallel {
                stage('Runtime Node 20') {
                    steps {
                        bat """
                            docker run --rm -v "%cd%:/workspace" -w /workspace node:20-alpine sh -c "for f in js/*.js; do node --check \\"$f\\"; done"
                        """
                    }
                }
                stage('Runtime Node 22') {
                    steps {
                        bat """
                            docker run --rm -v "%cd%:/workspace" -w /workspace node:22-alpine sh -c "for f in js/*.js; do node --check \\"$f\\"; done"
                        """
                    }
                }
            }
        }

        stage('Run Docker') {
            steps {
                bat """
                    docker build -t ${IMAGE_NAME} .
                    docker rm -f ${CONTAINER_NAME} 2>nul
                    docker run -d --name ${CONTAINER_NAME} -p 8081:80 ${IMAGE_NAME}
                    powershell -NoProfile -Command "Start-Sleep -Seconds 3"
                """
            }
        }

        stage('Smoke Test') {
            steps {
                // Since you are on Windows, we use curl.exe directly instead of the .sh script
                bat """
                    curl.exe --fail --retry 5 --retry-delay 2 --retry-connrefused http://localhost:8081/
                """
            }
        }

        stage('Archive Artifacts') {
            steps {
                bat """
                    if not exist artifacts mkdir artifacts
                    docker logs ${CONTAINER_NAME} > artifacts/docker.log 2>&1
                    echo Release version: ${TAG_NAME} > artifacts/release-report.txt
                    echo Commit: ${GIT_COMMIT} >> artifacts/release-report.txt
                    echo Release status: PASSED >> artifacts/release-report.txt
                    copy Dockerfile artifacts/Dockerfile
                """
                archiveArtifacts artifacts: 'artifacts/**', fingerprint: true
            }
        }
    }
    
    // Added a post block to ensure cleanup ALWAYS happens, even if a stage fails
    post {
        always {
            bat "docker rm -f ${CONTAINER_NAME} 2>nul || exit 0"
        }
    }
}
