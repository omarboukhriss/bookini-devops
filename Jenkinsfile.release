pipeline {
    agent any

    environment {
        VERSION = "${TAG_NAME}"
        IMAGE_NAME = "bookini:${TAG_NAME}"
        CONTAINER_NAME = "bookini-release"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                sh '''
                    echo "Release build"
                    echo "Version: ${TAG_NAME}"

                    docker --version
                    git --version
                '''
            }
        }

        stage('Build') {
            parallel {

                stage('Runtime Node 20') {
                    steps {
                        sh '''
                            docker run --rm \
                              -v "$PWD:/workspace" \
                              -w /workspace \
                              node:20-alpine \
                              sh -c 'for f in js/*.js; do node --check "$f"; done'
                        '''
                    }
                }

                stage('Runtime Node 22') {
                    steps {
                        sh '''
                            docker run --rm \
                              -v "$PWD:/workspace" \
                              -w /workspace \
                              node:22-alpine \
                              sh -c 'for f in js/*.js; do node --check "$f"; done'
                        '''
                    }
                }
            }
        }

        stage('Run Docker') {
            steps {
                sh '''
                    docker build \
                      -t ${IMAGE_NAME} \
                      .

                    docker rm -f ${CONTAINER_NAME} || true

                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p 8080:80 \
                      ${IMAGE_NAME}

                    sleep 3
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    chmod +x scripts/smoke-test.sh

                    ./scripts/smoke-test.sh \
                      http://localhost:8080
                '''
            }
        }

        stage('Archive Artifacts') {
            steps {
                sh '''
                    mkdir -p artifacts

                    docker logs ${CONTAINER_NAME} \
                      > artifacts/docker.log 2>&1 || true

                    echo "Release version: ${TAG_NAME}" \
                      > artifacts/release-report.txt

                    echo "Commit: ${GIT_COMMIT}" \
                      >> artifacts/release-report.txt

                    echo "Release status: PASSED" \
                      >> artifacts/release-report.txt

                    cp Dockerfile artifacts/Dockerfile
                '''

                archiveArtifacts artifacts: 'artifacts/**',
                    fingerprint: true
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true
                '''
            }
        }
    }
}