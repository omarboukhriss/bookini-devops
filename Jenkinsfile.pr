
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                bat '''
                    echo Preparing CI environment
                    docker --version
                    node --version
                '''
            }
        }

        stage('Build') {
            steps {
                bat '''
                    echo Validating JavaScript

                    docker run --rm -v "%WORKSPACE%:/workspace" -w /workspace node:22-alpine sh -c "for f in js/*.js; do [ -f $f ] || continue; node --check $f || exit 1; done"

                    if errorlevel 1 exit /b 1

                    echo Building Docker image

                    docker build -t bookini:pr-%BUILD_NUMBER% .
                '''
            }
        }

        stage('Run Docker') {
            steps {
                bat '''
                    echo Starting Bookini container

                    docker rm -f bookini-pr 2>nul

                    docker run -d --name bookini-pr -p 8080:80 bookini:pr-%BUILD_NUMBER%

                    if errorlevel 1 exit /b 1

                    powershell -NoProfile -Command "Start-Sleep -Seconds 3"

                    docker ps
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                bat '''
                    echo Testing application availability

                    curl.exe --fail --retry 5 --retry-delay 2 --retry-connrefused http://localhost:8080/

                    if errorlevel 1 exit /b 1

                    echo Smoke Test PASSED
                '''
            }
        }

        stage('Archive Artifacts') {
            steps {
                bat '''
                    if not exist artifacts mkdir artifacts

                    docker logs bookini-pr > artifacts/docker.log 2>&1

                    echo PR build: %BUILD_NUMBER% > artifacts/build-report.txt

                    echo Commit: %GIT_COMMIT% >> artifacts/build-report.txt

                    echo Status: PASSED >> artifacts/build-report.txt
                '''

                archiveArtifacts artifacts: 'artifacts/**',
                    fingerprint: true
            }
        }

        stage('Cleanup') {
            steps {
                bat '''
                    echo Cleaning up Docker resources

                    docker rm -f bookini-pr 2>nul

                    docker rmi bookini:pr-%BUILD_NUMBER% 2>nul

                    echo Cleanup completed
                '''
            }
        }
    }
}
