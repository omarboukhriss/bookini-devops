pipeline {
    agent any

    environment {
        IMAGE_NAME = "bookini-dev:${BUILD_NUMBER}"
        CONTAINER_NAME = "bookini-dev"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                bat '''
                    echo === ENVIRONMENT ===
                    docker --version
                    git --version
                    echo Branch: %BRANCH_NAME%
                    echo Build: %BUILD_NUMBER%
                '''
            }
        }

        stage('Build') {
            parallel {

                stage('Runtime Node 20') {
                    steps {
                        bat '''
                            docker run --rm ^
                              -v "%CD%:/workspace" ^
                              -w /workspace ^
                              node:20-alpine ^
                              sh -c "for f in js/*.js; do node --check \\"$f\\"; done"
                        '''
                    }
                }

                stage('Runtime Node 22') {
                    steps {
                        bat '''
                            docker run --rm ^
                              -v "%CD%:/workspace" ^
                              -w /workspace ^
                              node:22-alpine ^
                              sh -c "for f in js/*.js; do node --check \\"$f\\"; done"
                        '''
                    }
                }

                stage('Docker Image') {
                    steps {
                        bat '''
                            docker build ^
                              -t %IMAGE_NAME% ^
                              .
                        '''
                    }
                }
            }
        }

        stage('Run Docker') {
            steps {
                bat '''
                    docker rm -f %CONTAINER_NAME% 2>nul || exit /b 0

                    docker run -d ^
                      --name %CONTAINER_NAME% ^
                      -p 8082:80 ^
                      %IMAGE_NAME%

                    timeout /t 3 /nobreak >nul

                    docker ps
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                bat '''
                    scripts\\smoke-test.bat http://localhost:8082
                '''
            }
        }

        stage('Archive Artifacts') {
            steps {
                bat '''
                    if not exist artifacts mkdir artifacts

                    docker logs %CONTAINER_NAME% ^
                      > artifacts\\docker.log 2>&1

                    echo Build number: %BUILD_NUMBER% ^
                      > artifacts\\build-report.txt

                    echo Branch: %BRANCH_NAME% ^
                      >> artifacts\\build-report.txt

                    echo Commit: %GIT_COMMIT% ^
                      >> artifacts\\build-report.txt

                    echo Smoke test: PASSED ^
                      >> artifacts\\build-report.txt
                '''

                archiveArtifacts artifacts: 'artifacts/**',
                    fingerprint: true
            }
        }

        stage('Cleanup') {
            steps {
                bat '''
                    docker rm -f %CONTAINER_NAME% 2>nul || exit /b 0
                    docker rmi %IMAGE_NAME% 2>nul || exit /b 0
                '''
            }
        }
    }
}
